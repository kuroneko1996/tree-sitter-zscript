{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "zscript",
      "camelcase": "ZScript",
      "title": "ZScript",
      "scope": "source.zscript",
      "file-types": [
        "zscript"
      ],
      "injection-regex": "^zscript$",
      "class-name": "TreeSitterZscript"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "ZScript language from ZDoom",
    "authors": [
      {
        "name": "kuroneko1996",
        "email": "20803349+kuroneko1996@users.noreply.github.com",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-zscript",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}